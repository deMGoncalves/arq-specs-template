{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "name": "Documentation-First Approach",
  "version": "3.0.0",
  "description": "Production-ready system for specification-driven software development using Claude Code",
  "type": "framework",
  "status": "production",
  "created": "2025-11-01",
  "lastUpdated": "2025-12-10",
  "author": {
    "name": "Cleber Gonçalves",
    "email": "clebercoutof@gmail.com",
    "url": "https://github.com/clebercoutof"
  },
  "contributors": [
    {
      "name": "Claude Sonnet 4.5",
      "role": "AI Assistant",
      "affiliation": "Anthropic"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/clebercoutof/arq-specs-template.git"
  },
  "license": "MIT",
  "keywords": [
    "documentation-first",
    "specification-driven-development",
    "arc42",
    "c4-model",
    "bdd",
    "ddd",
    "ai-assisted-development",
    "claude-code",
    "deterministic-specifications"
  ],
  "domain": {
    "primaryDomain": "Software Architecture",
    "subDomains": [
      "AI-Driven Development",
      "Documentation Automation",
      "Quality Assurance"
    ],
    "boundedContexts": [
      {
        "name": "specification-management",
        "description": "Create and maintain Arc42 documentation",
        "location": "specs/",
        "size": "large"
      },
      {
        "name": "code-generation",
        "description": "Generate code from specifications",
        "location": "src/",
        "size": "large"
      },
      {
        "name": "quality-assurance",
        "description": "Enforce quality standards",
        "location": ".claude/rules/",
        "size": "medium"
      },
      {
        "name": "workflow-orchestration",
        "description": "Manage 7-phase development workflow",
        "location": ".claude/skills/",
        "size": "large"
      }
    ]
  },
  "standards": {
    "documentation": {
      "framework": "Arc42",
      "version": "8.0",
      "chapters": 12,
      "minimumRequired": 8,
      "url": "https://arc42.org"
    },
    "architecture": {
      "model": "C4",
      "levels": 4,
      "url": "https://c4model.com"
    },
    "behavioral": {
      "framework": "BDD",
      "syntax": "Gherkin",
      "url": "https://cucumber.io"
    },
    "decisions": {
      "format": "ADR",
      "template": "MADR",
      "url": "https://adr.github.io"
    },
    "design": {
      "approach": "DDD Tactical Co-Located",
      "patterns": [
        "Aggregate",
        "Entity",
        "Value Object",
        "Repository",
        "Factory",
        "Domain Event"
      ]
    }
  },
  "qualityGates": {
    "testCoverage": {
      "minimum": 0.80,
      "target": 0.90,
      "blocking": true
    },
    "complexityCeiling": {
      "cyclomatic": 10,
      "cognitive": 15,
      "blocking": true
    },
    "codeQuality": {
      "rules": 39,
      "criticalRulesBlocking": true,
      "categories": [
        "Object Calisthenics (9)",
        "SOLID (5)",
        "Package Principles (6)",
        "Code Quality (19)"
      ]
    },
    "specCompleteness": {
      "arc42Chapters": 8,
      "bddScenariosRequired": true,
      "adrsRequired": true,
      "blocking": false
    },
    "documentation": {
      "syncWithCode": true,
      "maxDrift": 0.05,
      "todosAllowed": false
    }
  },
  "workflow": {
    "phases": 7,
    "required": [1, 3, 3.5, 4, 5, 6, 7],
    "optional": [2],
    "phaseDescriptions": {
      "1": "Discovery - analyst agent",
      "2": "Architecture - architect agent (HIGH complexity only)",
      "3": "Specification - analyst agent",
      "3.5": "Task Decomposition - orchestrator agent (CRITICAL)",
      "4": "Implementation - developer + gatekeeper agents",
      "5": "Review - reviewer + tester agents",
      "6": "Documentation - documenter agent",
      "7": "Validation - guardian agent"
    },
    "taskSizeLimit": {
      "linesOfCode": 100,
      "reason": "Prevents AI hallucination from large contexts (O(n²) attention degradation)"
    }
  },
  "complexity": {
    "classifications": [
      {
        "level": "LOW",
        "score": "13-16",
        "criteria": "1 bounded context, <5 files, established patterns",
        "phases": "1, 3, 4-7 (skip 2)",
        "estimatedTime": "2-6 hours"
      },
      {
        "level": "MEDIUM",
        "score": "9-12",
        "criteria": "Multiple components, 5-15 files, some new patterns",
        "phases": "1, 3, 3.5, 4-7 (skip 2)",
        "estimatedTime": "1-3 days"
      },
      {
        "level": "HIGH",
        "score": "1-8",
        "criteria": "Multiple contexts, >15 files, architectural decisions",
        "phases": "1-7 (all phases)",
        "estimatedTime": "1-2 weeks"
      }
    ]
  },
  "tools": {
    "commands": {
      "count": 15,
      "location": ".claude/commands/",
      "purpose": "Arc42 documentation commands"
    },
    "skills": {
      "count": 9,
      "location": ".claude/skills/",
      "purpose": "Specialized AI agents for 7-phase workflow"
    },
    "templates": {
      "count": 20,
      "location": ".claude/templates/",
      "categories": ["arc42", "c4", "bdd", "adr", "changes"]
    },
    "rules": {
      "count": 39,
      "location": ".claude/rules/",
      "categories": [
        "object-calisthenics",
        "solid",
        "package-principles",
        "code-quality"
      ]
    },
    "hooks": {
      "count": 3,
      "location": ".claude/hooks/",
      "purpose": "Automated validation triggers"
    },
    "prompts": {
      "location": ".claude/prompts/",
      "categories": ["analysis", "design", "implementation", "review", "documentation"]
    },
    "examples": {
      "location": ".claude/examples/",
      "categories": ["ddd-patterns", "architecture", "bdd-scenarios", "quality-rules"]
    },
    "validators": {
      "location": ".claude/validators/",
      "categories": ["specification", "code", "documentation"]
    }
  },
  "metrics": {
    "hallucinationRate": {
      "before": "60-80%",
      "after": "<10%",
      "improvement": "85% reduction"
    },
    "reworkRate": {
      "before": "50-70%",
      "after": "<15%",
      "improvement": "78% reduction"
    },
    "testCoverage": {
      "before": "Variable",
      "after": "≥80%",
      "improvement": "Consistent"
    },
    "technicalDebt": {
      "before": "High",
      "after": "Low",
      "improvement": "Controlled"
    },
    "implementationTime": {
      "before": "Unpredictable",
      "after": "Predictable",
      "improvement": "Estimable"
    }
  },
  "ai": {
    "primaryModel": "claude-sonnet-4.5",
    "fallbackModel": "claude-haiku",
    "contextOptimization": {
      "enabled": true,
      "claudeignore": true,
      "maxContextSize": 500,
      "reason": "Lost in the Middle effect (Liu et al. 2023)"
    },
    "determinism": {
      "strategy": "specification-driven",
      "interpretationSpace": "~10 equivalent implementations",
      "reductionFactor": "10¹⁹ (from 10²⁰ to ~10)"
    }
  },
  "ci": {
    "provider": "GitHub Actions",
    "workflows": [
      {
        "name": "validate-specs",
        "trigger": "push, pull_request",
        "checks": [
          "Arc42 chapters (≥8)",
          "BDD scenarios",
          "ADRs",
          "TODOs/placeholders"
        ]
      },
      {
        "name": "lint-markdown",
        "trigger": "push, pull_request",
        "checks": [
          "Markdown formatting",
          "Link validation"
        ]
      }
    ]
  },
  "integrations": {
    "github": {
      "templates": {
        "issues": [
          "bug_report.yml",
          "feature_request.yml"
        ],
        "pullRequest": "pull_request_template.md"
      },
      "actions": true
    },
    "citation": {
      "format": "CFF",
      "file": "CITATION.cff",
      "compatible": ["Zotero", "Mendeley", "EndNote"]
    }
  },
  "fileStructure": {
    ".claude/": "Development tools and AI configuration",
    "specs/": "Arc42 documentation (12 chapters) - THE CONSTITUTION",
    "changes/": "Active changes (proposal → design → spec → tasks)",
    "src/": "Source code (DDD Tactical Co-Located)",
    "tests/": "Test suites",
    "docs/": "Additional documentation"
  },
  "urls": {
    "repository": "https://github.com/clebercoutof/arq-specs-template",
    "documentation": "https://github.com/clebercoutof/arq-specs-template/blob/main/README.md",
    "issues": "https://github.com/clebercoutof/arq-specs-template/issues",
    "changelog": "https://github.com/clebercoutof/arq-specs-template/blob/main/CHANGELOG.md"
  },
  "scientificFoundation": {
    "primaryResearch": {
      "title": "Lost in the Middle: How Language Models Use Long Contexts",
      "authors": ["Nelson F. Liu et al."],
      "year": 2023,
      "finding": "AI attention degradation with large contexts (O(n²))",
      "url": "https://arxiv.org/abs/2307.03172"
    },
    "influences": [
      {
        "title": "Domain-Driven Design",
        "author": "Eric Evans",
        "year": 2003
      },
      {
        "title": "Clean Code",
        "author": "Robert C. Martin",
        "year": 2008
      },
      {
        "title": "Object Calisthenics",
        "author": "Jeff Bay",
        "year": 2006
      }
    ]
  },
  "community": {
    "contributionGuide": "CONTRIBUTING.md",
    "codeOfConduct": "CODE_OF_CONDUCT.md",
    "security": "SECURITY.md",
    "maintainers": [
      {
        "name": "Cleber Gonçalves",
        "role": "Lead Maintainer",
        "github": "@clebercoutof"
      }
    ]
  }
}
